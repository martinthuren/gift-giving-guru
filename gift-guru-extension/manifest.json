{
    "manifest_version": 3,
    "name": "Gift Giving Guru Helper",
    "version": "0.1.1",
    "description": "Quickly save gift ideas from any webpage to your Gift Giving Guru account.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:5000/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "options_page": "options.html"
} 